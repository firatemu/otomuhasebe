FROM node:20-alpine
WORKDIR /app/server

# pnpm kur
RUN npm install -g pnpm@10

# Package files
COPY package.json pnpm-lock.yaml* ./
COPY tsconfig.json tsconfig.build.json nest-cli.json .swcrc* ./

# Install deps
RUN pnpm install

# Source code (skip prisma generate for now)
COPY src ./src

# Build
RUN pnpm run build

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

# Watch modunda başlat
CMD ["pnpm", "dev"]